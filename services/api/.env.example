# Documentation only. The API reads process environment variables directly and
# does not load this file. Replace every example value in the Vercel dashboard.

APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@POOL_HOST/DATABASE?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
CORS_ORIGINS=["https://app.example.com"]
AUTO_CREATE_SCHEMA=false
SEED_ON_START=false

# Configure either CLERK_JWT_PUBLIC_KEY or CLERK_JWKS_URL.
CLERK_JWT_PUBLIC_KEY=
CLERK_JWKS_URL=https://your-clerk-domain.example/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.example
# Clerk Dashboard > Sessions > Customize session token must emit a valid
# `email` claim. `name`/`fullName` are optional. See the API README.
# Set this only after adding the matching `aud` custom session claim in Clerk.
# Clerk's default session token has no `aud`, so empty is the safe default.
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=["https://app.example.com"]
# Server-side owner administration fails closed when this list is empty.
OWNER_ADMIN_ALLOWLIST=["replace-with-clerk-user-id-or-email"]
DEMO_AUTH_MODE=false

STORAGE_BACKEND=vercel_blob
VERCEL_BLOB_TOKEN=
VERCEL_BLOB_ACCESS=private
BLOB_UPLOAD_GATEWAY_URL=https://app.example.com/api/blob/upload
BLOB_SIGNING_GATEWAY_URL=https://app.example.com/api/blob/sign
BLOB_GATEWAY_SHARED_SECRET=
INTERNAL_SERVICE_SHARED_SECRET=
WORKFLOW_DISPATCH_URL=https://app.example.com/api/workflow/dispatch
WORKFLOW_DISPATCH_TIMEOUT_SECONDS=10
WORKFLOW_DISPATCH_LEASE_SECONDS=30
WORKFLOW_SSE_MAX_SECONDS=15
WORKFLOW_SSE_POLL_SECONDS=0.5

# Server-only AES-256-GCM keyring for user-supplied model credentials. Values
# are base64-encoded 32-byte random keys; retain old versions during rotation.
# Leave empty unless BYOK is enabled. Never copy a public example key.
PROVIDER_ENCRYPTION_KEYS={}
PROVIDER_CURRENT_KEY_VERSION=v1
PROVIDER_VALIDATION_TIMEOUT_SECONDS=10

MAX_UPLOAD_BYTES=10485760
MAX_USER_STORAGE_BYTES=104857600
MAX_GLOBAL_STORAGE_BYTES=786432000
UPLOAD_RESERVATION_TTL_SECONDS=900
WORKFLOW_EVENT_MAX_BYTES=32768
WORKFLOW_MAX_EVENTS_PER_RUN=100
WORKFLOW_MAX_PROVIDER_CALLS=5
WORKFLOW_ARTIFACT_MAX_BYTES=1048576
WORKFLOW_MAX_AGGREGATE_ASSET_BYTES=26214400
WORKFLOW_SLOT_COUNT=2
WORKFLOW_SLOT_LEASE_SECONDS=1500
MAX_WORKFLOW_ASSETS=3
MAX_ROWS_PER_FILE=100000
MAX_COLUMNS_PER_FILE=200
DATA_RUNS_PER_USER_PER_DAY=5
DEPLOYMENT_RUNS_PER_DAY=10
TEXT_RUNS_PER_USER_PER_DAY=20
FEEDBACK_SUBMISSIONS_PER_DAY=100
MAX_DASHBOARD_BYTES=1048576
DASHBOARD_VERSION_RETENTION=25
MAX_BLOG_CONTENT_BYTES=1048576
MAX_DATABASE_BYTES=367001600

BILLING_ENABLED=false
CONNECTORS_ENABLED=false
