{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamify.dev/schemas/sandbox-request.schema.json",
  "title": "Dreamify Sandbox request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "assets"],
  "properties": {
    "schema_version": { "const": "1" },
    "run_id": { "$ref": "#/$defs/id" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/asset" }
    },
    "code": { "type": "string", "minLength": 1, "maxLength": 12288 }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "object_id", "file_name", "format", "media_type", "size_bytes", "sha256", "relative_path"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/id" },
        "object_id": { "$ref": "#/$defs/id" },
        "file_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "format": { "enum": ["csv", "xlsx", "xls", "json"] },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "relative_path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sheet_name": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
