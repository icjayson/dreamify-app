# Public browser configuration
# This is a Next.js application: legacy VITE_* names are ignored. In particular,
# rename VITE_API_URL and VITE_CLERK_PUBLISHABLE_KEY to the names below.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional for local development; mandatory in Vercel production and preview.
# The paired keys must belong to the same Clerk instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuZHJlYW1pZnkuZGV2JA
# Server-only Clerk credential used by Next.js route protection.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/workspace
# Local development only. Production always fails closed without Clerk.
NEXT_PUBLIC_DEMO_AUTH_MODE=true

# Optional browser-only integrations
NEXT_PUBLIC_GA_ID=G-G19753100P
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# Server-only API connection used by the Blob upload gateway
DREAMIFY_API_URL=http://localhost:5000
BLOB_TOKEN_VALIDATE_PATH=/api/v1/uploads/blob-token/validate
BLOB_UPLOAD_COMPLETED_PATH=/api/v1/uploads/blob-completed

# Server-only Vercel Blob credentials. Never prefix these with NEXT_PUBLIC_.
# A connected store normally injects BLOB_READ_WRITE_TOKEN; the private-prefixed
# alias is also supported when the token is copied from a separately owned store.
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_READ_WRITE_TOKEN=
BLOB_GATEWAY_SHARED_SECRET=

# Server-to-server Workflow/Sandbox configuration
# Generate each shared secret independently with at least 32 characters.
INTERNAL_SERVICE_SHARED_SECRET=
SANDBOX_SNAPSHOT_ID=

# Vercel production/preview preflight requires HTTPS origin-only site/API URLs,
# Clerk keys, demo auth=false, one Blob token, both independent shared secrets,
# and a pinned snap_* Sandbox ID. Placeholder values fail the deployment.
