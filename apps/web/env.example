# Dreamify App Analytics Platform - Environment Variables

# Application
NODE_ENV=development

# Frontend Configuration
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=Dreamify App Analytics
VITE_APP_VERSION=1.0.0

# FastAPI Backend Configuration
FASTAPI_SECRET_KEY=your-secret-key-here
FASTAPI_DEBUG=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=5000

# Database Configuration (if using database)
DATABASE_URL=sqlite:///dreamify_app.db
DATABASE_TEST_URL=sqlite:///test_dreamify_app.db

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=csv,xlsx,xls

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# Security Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour
JWT_REFRESH_TOKEN_EXPIRES=86400  # 24 hours

# External Services (if applicable)
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_ANALYTICS_ID=your-ga-id

# Meta Pixel (Facebook Pixel) — get your ID from Meta Events Manager
# https://business.facebook.com/events_manager
# VITE_META_PIXEL_ID=your-meta-pixel-id
